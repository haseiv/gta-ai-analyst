DISCORD_TOKEN=

AI_API_KEY=
AI_MODEL=qwen/qwen3.8-27b
AI_BASE_URL=https://api.groq.com/openai/v1

YOLO_MODEL_PATH=models/default.pt

DATABASE_URL=sqlite:///data/database/gta_ai.db

MAX_VIDEO_SIZE_MB=2000
ANALYSIS_FPS=5
# Без GTA-модели анализируются только HUD и события; 0.5 FPS сильно ускоряет OCR.
HUD_ANALYSIS_FPS=0.5

MAX_CONCURRENT_ANALYSES=1

REPLAY_CHANNEL_ID=
REPLAY_RETENTION_MINUTES=30
DELETE_REPLAY_AFTER_SEND=true

DEVELOPER_USER_IDS=

HUMAN_EXAMPLES_TOP_K=5

LOG_LEVEL=INFO
YTDLP_COOKIES_FILE=
# Для Docker/облака: base64 от cookies.txt. Не заполняй обе переменные сразу.
YTDLP_COOKIES_BASE64=
